FROM node:22-slim AS base

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies with production flag
RUN npm ci --only=production

# Copy source code
COPY . .

# Remove development files
RUN rm -rf tests/ docs/ .github/ .husky/ coverage/

# Remove test files from dependencies
RUN find node_modules -type d -name "test" -o -name "tests" | xargs rm -rf
RUN find node_modules -type d -name "example" -o -name "examples" | xargs rm -rf
RUN find node_modules -type d -name "docs" | xargs rm -rf
RUN find node_modules -type f -name "*.md" | xargs rm -f
RUN find node_modules -type f -name "*.ts" | xargs rm -f
RUN find node_modules -type f -name "*.map" | xargs rm -f

# Run health check tests in build phase
RUN echo "Running health checks to verify build..."
RUN node -e "const http = require('http'); \
             const app = require('./src/app'); \
             const server = http.createServer(app); \
             server.listen(0, '127.0.0.1', () => { \
               const port = server.address().port; \
               console.log('Testing health endpoint on port', port); \
               http.get(\`http://127.0.0.1:\${port}/health\`, (res) => { \
                 let data = ''; \
                 res.on('data', (chunk) => { data += chunk; }); \
                 res.on('end', () => { \
                   console.log('Health check response:', data); \
                   if (res.statusCode !== 200) { \
                     console.error('Health check failed with status:', res.statusCode); \
                     process.exit(1); \
                   } \
                   console.log('Health check passed!'); \
                   server.close(() => process.exit(0)); \
                 }); \
               }).on('error', (err) => { \
                 console.error('Health check error:', err); \
                 process.exit(1); \
               }); \
             });"

FROM node:22-slim AS production

WORKDIR /app

# Copy only necessary files from base
COPY --from=base /app/package*.json ./
COPY --from=base /app/node_modules ./node_modules
COPY --from=base /app/src ./src
COPY --from=base /app/sls.js ./
COPY --from=base /app/serverless.yml ./
COPY --from=base /app/env.json ./

# Add healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

# Default command
CMD ["node", "src/index.js"] 