# Environment (development, production, test)
NODE_ENV=development
PORT=3000

# Database
MONGODB_URL=mongodb://localhost:27017/surebank-dev

# System
SYSTEM_ACCOUNT_ID=your-system-account-id

# Blockchain (will auto-select based on NODE_ENV if not specified)
# SMART_CHAIN_NODE=https://bsc-dataseed.binance.org
# MATIC_NODE=https://polygon-rpc.com
MASTER_ADDRESS_PK=your-master-private-key

# JWT (will auto-select based on NODE_ENV if not specified)
JWT_SECRET=your-jwt-secret-key-change-this
# JWT_ACCESS_EXPIRATION_MINUTES=30
# JWT_REFRESH_EXPIRATION_DAYS=30
# JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
# JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# Email
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@surebankstores.ng
EMAIL_TEMPLATE_DIRECTORY=./src/templates/emails

# Mailgun
MAILGUN_DOMAIN=surebankstores.ng
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_API_USERNAME=postmaster@surebankstores.ng
MAILGUN_BASE_URL=https://api.eu.mailgun.net

# Reloadly (will auto-select based on NODE_ENV if not specified)
RELOADLY_CLIENT_ID=your-reloadly-client-id
RELOADLY_CLIENT_SECRET=your-reloadly-client-secret
# RELOADLY_TOPUPS_BASE_URL=https://topups.reloadly.com

# SMS (will auto-select sender based on NODE_ENV if not specified)
SMS_API_TOKEN=your-sms-api-token
# SMS_SENDER=SUREBANK
SMS_TEMPLATE_DIRECTORY=./src/templates/sms

# Meta/WhatsApp
META_PHONE_NUMBER_ID=your-meta-phone-number-id
META_ACCESS_TOKEN=your-meta-access-token